[Unit]
Description=Yandex Station %i logcat spotter wake
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=/storage/yse/%i.env
ExecStart=/storage/yse-music/.venv/bin/python -u /storage/yse/app/yse_max_log_wake.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target